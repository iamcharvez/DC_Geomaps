{$CADDY_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# Key-protected, read-only discovery and MapLibre style endpoints for other apps.
	# Administrative key management beneath this prefix remains Keycloak-protected.
	handle /api/v1/integration* {
		@preflight method OPTIONS
		header @preflight Access-Control-Allow-Origin "{http.request.header.Origin}"
		header @preflight Access-Control-Allow-Methods "GET, HEAD, POST, OPTIONS"
		header @preflight Access-Control-Allow-Headers "Accept, Authorization, Content-Type, X-API-Key, Range"
		header @preflight Access-Control-Max-Age "86400"
		header @preflight Vary "Origin"
		respond @preflight 204

		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	@basemapPreflight {
		path /basemap/*
		method OPTIONS
	}
	handle @basemapPreflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, X-API-Key, Range, If-Match, If-None-Match"
		header Access-Control-Max-Age "86400"
		header Vary "Origin"
		respond 204
	}

	handle_path /basemap/* {
		forward_auth api:8080 {
			uri /api/v1/integration/authorize
		}
		root * /basemap-data/public
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Vary "Origin, Authorization, X-API-Key"
		header Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag, Last-Modified"

		@manifest path /active.json /health.json
		header @manifest Cache-Control "no-cache, no-store, must-revalidate"

		@archive path *.pmtiles
		header @archive Cache-Control "private, max-age=31536000, immutable"
		header @archive Content-Type "application/vnd.pmtiles"

		# Directory browsing is disabled unless the browse option is explicitly enabled.
		file_server
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html
		header @entry Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
