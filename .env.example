# Public entry point. WEB_PORT/WEB_HTTPS_PORT are host ports; the containers keep
# using 80/443 internally and therefore do not occupy those host ports.
CADDY_SITE_ADDRESS=:80
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_HTTPS_PORT=8443
APP_ORIGIN=http://localhost:8080

# Keycloak direct-access client. Only role_dcgeomaps_admin is accepted.
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=dcgeomaps
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_ALLOW_HTTP=false
KEYCLOAK_REQUIRED_ROLE=role_dcgeomaps_admin

# Internal worker authentication. Generate a long random value.
WORKER_SHARED_SECRET=replace-with-at-least-32-random-characters

# Public, credential-free integration access. Keep * for multiple browser apps,
# or replace both values with one exact app origin to restrict browser CORS.
BASEMAP_ALLOWED_ORIGIN=*
INTEGRATION_ALLOWED_ORIGIN=*
BASEMAP_MANIFEST_URL=/basemap/active.json

# Basemap source and schedule (Asia/Manila local time).
OSM_PBF_URL=https://download.geofabrik.de/asia/philippines-latest.osm.pbf
OSM_CHECKSUM_URL=https://download.geofabrik.de/asia/philippines-latest.osm.pbf.md5
TZ=Asia/Manila
DAILY_UPDATE_HOUR=2
MONTHLY_REBUILD_HOUR=1

# Build resource controls.
PLANETILER_JAVA_OPTS=-Xmx8g
PLANETILER_THREADS=4
PLANETILER_MAX_ZOOM=15
MIN_FREE_DISK_GB=25
UPDATE_CHECK_INTERVAL_SECONDS=60

# Reliability and safety controls.
DOWNLOAD_RETRIES=5
DOWNLOAD_RETRY_BASE_SECONDS=5
DOWNLOAD_TIMEOUT_SECONDS=120
SCHEDULED_RETRY_MINUTES=30
SCHEDULED_RETRY_MAX_ATTEMPTS=5
DISK_WORKING_MULTIPLIER=8
MEMORY_RESERVE_MB=512
MIN_AVAILABLE_MEMORY_MB=256

# Worker file logs and Docker stdout logs rotate independently.
WORKER_LOG_MAX_MB=50
WORKER_LOG_BACKUPS=3
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
